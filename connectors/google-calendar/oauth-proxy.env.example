# Add google-calendar:google to the existing PROVIDERS list.
# This standalone value is for a Calendar-only development relay.
PROVIDERS='google-calendar:google'

# Supply via the secret manager. Use separate testing/production clients.
GOOGLE_CALENDAR_CLIENT_ID=''
GOOGLE_CALENDAR_CLIENT_SECRET=''
GOOGLE_CALENDAR_DISPLAY_NAME='Google Calendar'
GOOGLE_CALENDAR_SCOPES='https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.events.freebusy'
GOOGLE_CALENDAR_UPSTREAM_MODE='openapi'
GOOGLE_CALENDAR_UPSTREAM_NAME='Google Calendar'
GOOGLE_CALENDAR_UPSTREAM_URL='https://www.googleapis.com/calendar/v3/'
# Replace with the published commit containing the curated schema.
GOOGLE_CALENDAR_UPSTREAM_SCHEMA_URL='https://raw.githubusercontent.com/tloncorp/mcp/REPLACE_WITH_RELEASE_COMMIT/connectors/google-calendar/discovery.json'

# OAuth web-client redirect URI must match the relay exactly:
# testing:    https://oauth.test.tlon.systems/v1/callback
# production: https://oauth.tlon.io/v1/callback
# The relay's existing google template supplies offline access and PKCE.
